# OPTIONAL — the app runs against the public instance (https://beta.lawallet.io)
# when this is unset.
#
# Point it at YOUR LaWallet instance to offer addresses on your own domain.
# It must be the origin the instance is publicly reachable at (no trailing
# slash): the SDK signs NIP-98 events against this exact URL.
VITE_LAWALLET_ENDPOINT=https://your-instance.example.com
