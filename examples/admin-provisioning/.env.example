# ── Backend only ────────────────────────────────────────────────────────────
# None of these carry a VITE_ prefix, which is the point: Vite only inlines
# VITE_*-prefixed variables into the browser bundle, so the admin key below
# cannot leak into client code even by accident.
#
# You do NOT need to create this file to try the example — on first run it
# generates an admin key and writes it here itself.

# Public origin of your LaWallet instance. Must match the instance's
# configured `endpoint` exactly — NIP-98 signatures commit to it.
# Defaults to this monorepo's dev server, then to https://beta.lawallet.io.
# LAWALLET_ENDPOINT=https://wallet.example.com

# nsec of a user holding `addresses:write` (ADMIN or OPERATOR) on that
# instance. Generated automatically when absent; the app then tells you how
# to grant it the role (and grants it itself on an instance with no owner).
# LAWALLET_ADMIN_NSEC=nsec1...

# How the backend authenticates to LaWallet:
#   nip98 (default) — signs every request with the admin key
#   jwt             — mints one session token at boot and sends it as Bearer
LAWALLET_ADMIN_AUTH=nip98

# Signs the proof-of-control challenges. Optional: a random secret is
# generated per boot, which simply invalidates challenges across restarts.
# LAWALLET_CHALLENGE_SECRET=
