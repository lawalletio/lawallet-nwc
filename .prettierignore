# Prettier also honours .gitignore, so build output (.next/, dist/, .turbo/,
# lib/generated/prisma, .source/) is already excluded. Listed here are tracked
# files that Prettier must NOT touch.

# Generated by scripts/docs-sync.mjs and compared byte-for-byte against
# `JSON.stringify(doc, null, 2)`. Reformatting it makes `pnpm docs:check`
# fail, which gates release.yml.
packages/openapi/openapi.snapshot.json

# Generated by pnpm; reformatting is churn the next install reverts.
pnpm-lock.yaml

# Vendored upstream skills, pinned by computedHash in skills-lock.json.
# Reformatting invalidates those hashes and buries real upstream diffs.
.agents/skills/
