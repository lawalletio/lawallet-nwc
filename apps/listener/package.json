{
  "name": "@lawallet-nwc/listener",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@getalby/sdk": "^8.0.3",
    "@lawallet-nwc/shared": "workspace:*",
    "@sentry/node": "^10.74.0",
    "light-bolt11-decoder": "^3.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.6",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
