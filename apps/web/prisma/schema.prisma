generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  // `rhel-openssl-3.0.x` is for AWS Lambda hosts (Netlify Functions): the
  // build image is Ubuntu, so `native` alone produces an engine the runtime
  // can't load. Vercel builds on Amazon Linux, where `native` already resolves
  // to this target.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
  USER
}

enum InvoicePurpose {
  REGISTRATION
  WALLET_ADDRESS
  LUD16_PAYMENT
}

enum InvoiceStatus {
  PENDING
  PAID
  EXPIRED
}

enum LightningAddressMode {
  IDLE // address exists but does nothing (disabled)
  ALIAS // forwards to another LN address via `redirect`
  PROXY_ALIAS // receives locally, then forwards to `redirect` after settlement
  CUSTOM_NWC // uses the RemoteWallet referenced by remoteWalletId
}

enum RemoteWalletType {
  NWC
  LND
  CLN
  BTCPAY
}

enum RemoteWalletStatus {
  ACTIVE
  DISABLED
  REVOKED
  /// Terminal "archived" state for a disposable LNCurl wallet that ran out of
  /// sats and was destroyed by the provider. The row is kept (with `diedAt`)
  /// so the user can see its death stats; it can't be bound to anything and
  /// can be permanently removed.
  DEAD
}

/// A card's kind. SIMPLE is an ordinary card. MASTER designates the holder's
/// account-recovery card — at most one per holder, enforced by a raw partial
/// unique index (see the `Card` doc comment). The designation is switchable
/// after creation via the card PATCH routes.
///
/// The recovery *mechanism* itself (FOREVER share QRs, CardClaim,
/// LightningAddressShare/RemoteWalletShare) is still deferred — see
/// docs/roadmap/MONTH-6.md. Today MASTER only marks the card.
enum CardKind {
  SIMPLE
  MASTER
}

/// The kind of an activation QR. ONE_TIME burns on first claim and transfers
/// card ownership. FOREVER is reserved for MASTER account-sharing and is not
/// mintable yet — the activation-token route rejects it.
enum ActivationQrKind {
  ONE_TIME
  FOREVER
}

/// Lifecycle of a CardActivationToken. ONE_TIME tokens reach CLAIMED on a
/// successful claim; superseded/rescued tokens become REVOKED.
enum ActivationTokenStatus {
  PENDING
  CLAIMED
  REVOKED
  EXPIRED
}

enum ActivityCategory {
  USER
  ADDRESS
  NWC
  INVOICE
  CARD
  SERVER
}

enum ActivityLevel {
  INFO
  WARN
  ERROR
}

enum NostrProfileImageKind {
  AVATAR
  COVER
}

enum CardPaymentTransport {
  DIRECT
  LISTENER
}

enum CardPaymentStatus {
  PENDING
  SUCCEEDED
  REJECTED
  UNKNOWN
}

enum ProxyPaymentStatus {
  PENDING_INBOUND
  READY_TO_FORWARD
  FORWARDING
  RECEIPT_PENDING
  BLOCKED
  COMPLETED
  EXPIRED
}

enum ProxyForwardAttemptStatus {
  PENDING
  UNKNOWN
  REJECTED
  SUCCEEDED
  EXPIRED
}

enum RemoteWalletReceiveActionType {
  FORWARD
}

enum RemoteWalletForwardReceiptStatus {
  RECEIVED
  FORWARDING
  PARTIAL
  BLOCKED
  COMPLETED
  RETAINED
}

enum RemoteWalletForwardLegStatus {
  READY
  PENDING
  UNKNOWN
  REJECTED
  SUCCEEDED
  EXPIRED
  SUPERSEDED
}

enum RemoteWalletForwardAttemptStatus {
  PENDING
  UNKNOWN
  REJECTED
  SUCCEEDED
  EXPIRED
}

enum RemoteWalletNotificationChannel {
  WEBHOOK
  NOSTR
}

enum RemoteWalletNotificationAction {
  RECEIVED
  FORWARDED
}

enum RemoteWalletNotificationDeliveryStatus {
  READY
  PENDING
  UNKNOWN
  REJECTED
  SUCCEEDED
  EXPIRED
}

enum RemoteWalletNotificationAttemptStatus {
  PENDING
  UNKNOWN
  REJECTED
  SUCCEEDED
  EXPIRED
}

/// The ceremony a WebAuthnChallenge was minted for. REGISTER = new-account
/// signup (unauthenticated), LINK = add a credential to an existing account,
/// LOGIN = discoverable-credential authentication, EXPORT = step-up assertion
/// gating nsec export.
enum WebAuthnFlow {
  REGISTER
  LINK
  LOGIN
  EXPORT
}

/// Lifecycle of a stored coupons-protocol voucher. Mirrors the status a
/// coupon-manager service reports from `GET {claimUrl}?nonce=`
/// (`minted | claimed | expired | voided`). CLAIMED and VOIDED are terminal:
/// a burned coupon must never come back to life — see `lib/vouchers/transition.ts`.
enum VoucherStatus {
  MINTED
  /// A transfer is in flight. Set by a conditional MINTED -> TRANSFER_PENDING
  /// update *before* the outbound request, so an honest double-send cannot
  /// start; settled to TRANSFERRED or back to MINTED by the outcome.
  TRANSFER_PENDING
  /// Swapped away to another holder. Terminal: the nonce on this row was
  /// burned by the recipient's refresh and buys nothing. The row is kept as
  /// the only record of where the coupon went.
  TRANSFERRED
  CLAIMED
  EXPIRED
  VOIDED
}

/// Who may deposit vouchers to a user's stash via `POST /api/vouchers`.
/// Every deposit is NIP-98 authenticated regardless; this narrows *which*
/// signers the recipient accepts.
enum VoucherDepositPolicy {
  ANYONE
  ALLOWLIST
}

model User {
  id                                 String                             @id
  pubkey                             String                             @unique
  createdAt                          DateTime                           @default(now())
  cardDesigns                        CardDesign[]
  ntag424s                           Ntag424[]
  lightningAddresses                 LightningAddress[]
  remoteWallets                      RemoteWallet[]
  remoteWalletNotificationDeliveries RemoteWalletNotificationDelivery[]
  cards                              Card[]
  invoices                           Invoice[]
  albySubAccount                     AlbySubAccount?
  albyEnabled                        Boolean                            @default(false)
  role                               UserRole                           @default(USER)
  activityLogs                       ActivityLog[]
  /// The user's preferred Nostr relays (NIP-65-style), as a JSON-stringified
  /// `string[]` of `wss://` URLs. Null/absent means the user hasn't picked any
  /// and consumers fall back to the operator's configured relay list. Owner-
  /// editable via `PUT /api/users/[userId]/relays`, or auto-populated from the
  /// user's NIP-65 (kind:10002) relay list — see `lib/nostr/relay-list.ts`.
  relays                             String?
  /// When `relays` was last set (manual save) or refreshed from NIP-65. Drives
  /// the server-side relay-list cache TTL so nostr.json doesn't re-query relays
  /// on every request.
  relaysUpdatedAt                    DateTime?
  passkeyCredentials                 PasskeyCredential[]
  managedNostrKey                    ManagedNostrKey?
  nostrIdentities                    NostrIdentity[]
  walletForwardReceipts              RemoteWalletForwardReceipt[]
  vouchers                           Voucher[]
  voucherTransfers                   VoucherTransfer[]
  /// Who may deposit vouchers to this account. Deposits are always NIP-98
  /// signed; ALLOWLIST additionally restricts *which* signers are accepted.
  voucherDepositPolicy               VoucherDepositPolicy               @default(ANYONE)
  /// Whether this account's lightning address advertises `allowVouchers` and
  /// accepts LNURL voucher transfers. Off by default and opt-in: a transfer is
  /// an *anonymous* write into someone's stash, and that surface must not
  /// appear on every existing address the day the feature ships.
  allowVouchers                      Boolean                            @default(false)
  /// Hex pubkeys allowed to deposit while `voucherDepositPolicy` is ALLOWLIST.
  /// Always stored hex — npub and NIP-05 input is resolved on save so the
  /// deposit hot path is a plain array membership test.
  voucherSenderAllowlist             String[]                           @default([])

  @@index([role])
}

/// One Nostr pubkey belonging to an account. An account owns one or more
/// identities; exactly one is primary (enforced by a raw partial unique
/// index — Prisma can't express it). `User.pubkey` stays as a denormalized
/// mirror of the primary identity's pubkey: any of the account's pubkeys
/// authenticates it (see lib/auth/account.ts), but the account always
/// presents the primary as its public identity.
model NostrIdentity {
  pubkey    String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  /// User-assigned name ("Old laptop key").
  label     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One WebAuthn credential (passkey) bound to a user. `id` is the base64url
/// credential ID — globally unique per the WebAuthn spec, which is what lets
/// username-less (discoverable) login resolve the user. A duplicate
/// registration across accounts fails the PK constraint (mapped to 409)
/// instead of silently rebinding the credential.
model PasskeyCredential {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// COSE public key, verbatim from registration.
  publicKey  Bytes
  /// Signature counter (uint32; BigInt to avoid overflow). Platform passkeys
  /// (iCloud/Google) legitimately always report 0.
  counter    BigInt    @default(0)
  /// JSON string[] of AuthenticatorTransportFuture values.
  transports String?
  /// 'singleDevice' | 'multiDevice'
  deviceType String
  backedUp   Boolean   @default(false)
  /// Authenticator model id — audit/display only (attestation is 'none').
  aaguid     String?
  /// User-assigned name ("MacBook Touch ID").
  label      String?
  /// rpID captured at registration. Passkeys are cryptographically scoped to
  /// it — if the operator changes the instance domain, this lets login errors
  /// explain why an old credential no longer verifies.
  rpId       String
  /// The Nostr pubkey this credential's PRF output derives — i.e. which of
  /// the account's identities this passkey IS. Display/bookkeeping only;
  /// authentication goes through the derived key's NIP-98 signature.
  pubkey     String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// Server-custodied Nostr secret key for passkey-native users. The key is
/// NEVER stored in plaintext: `ciphertext` is the AES-256-GCM envelope from
/// lib/auth/key-vault.ts, AAD-bound to `userId`. Absent row = the user brought
/// their own signer (linked custody); the server never had their key.
model ManagedNostrKey {
  userId     String    @id
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ciphertext Bytes
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Last successful nsec export. Non-null unlocks deleting the user's final
  /// passkey (they provably hold the key themselves).
  exportedAt DateTime?
}

/// Single-use WebAuthn challenge. Consumed atomically (delete) on verify;
/// expired rows are opportunistically purged by the options endpoints.
/// rpId/origin are pinned at options time and used as the expected values at
/// verify, so a Host-header flip between the two calls fails closed. `userId`
/// is a plain column (not a relation): REGISTER challenges reference a
/// pre-allocated user id that doesn't exist yet.
model WebAuthnChallenge {
  id        String       @id @default(cuid())
  challenge String       @unique
  flow      WebAuthnFlow
  userId    String?
  rpId      String
  origin    String
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([expiresAt])
}

model CardDesign {
  id          String    @id @default(uuid())
  imageUrl    String
  description String
  createdAt   DateTime  @default(now())
  /// Non-null timestamp means the design has been archived and should be
  /// hidden from the default "Active" tab. Using a timestamp instead of a
  /// boolean so we can order archived designs by when they were archived.
  archivedAt  DateTime?
  cards       Card[]
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([archivedAt])
}

model Ntag424 {
  cid       String   @id
  k0        String
  k1        String
  k2        String
  k3        String
  k4        String
  ctr       Int
  createdAt DateTime @default(now())
  card      Card?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model LightningAddress {
  username       String               @id
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           LightningAddressMode @default(IDLE)
  redirect       String?
  remoteWalletId String?
  remoteWallet   RemoteWallet?        @relation(fields: [remoteWalletId], references: [id], onDelete: SetNull)
  isPrimary      Boolean              @default(false)
  /// Protocols the ALIAS target was found to support, captured when the
  /// redirect was saved: `{ lud16, lud21, nip57, lud12, checkedAt }`.
  ///
  /// Persisted rather than derived on read because the address list would
  /// otherwise fetch every alias target's payRequest on each page load, and
  /// confirming LUD-21 means asking that target to issue an invoice.
  aliasProtocols Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId])
  @@index([remoteWalletId])
}

/// Generic remote wallet attached by a user. `type` discriminates the driver;
/// `config` holds the driver-specific payload (e.g. NWC URI + mode). Encryption
/// of NWC connection strings at rest is enforced by the application vault
/// helpers — never persist an NWC `config` here without going through them.
model RemoteWallet {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  type                 RemoteWalletType
  config               Json
  /// Set after an NWC config has been encrypted with NWC_VAULT_SECRET. The
  /// envelope itself remains inside config.connectionString so other
  /// driver-specific config fields stay queryable.
  nwcConfigEncryptedAt DateTime?
  status               RemoteWalletStatus @default(ACTIVE)
  isDefault            Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  /// When a disposable LNCurl wallet was detected dead and archived (status
  /// DEAD). Null for every other wallet. Drives the "graveyard" death stats.
  diedAt               DateTime?

  lightningAddresses     LightningAddress[]
  cards                  Card[]
  receiveAction          RemoteWalletReceiveAction?
  forwardReceipts        RemoteWalletForwardReceipt[]
  notifications          RemoteWalletNotification[]
  notificationDeliveries RemoteWalletNotificationDelivery[]
  invoices               Invoice[]

  @@unique([userId, name])
  @@index([userId])
  @@index([type])
  @@index([status])
}

/// An owner-configured outbound notification attached to one RemoteWallet.
/// Channel-specific settings are nullable and guarded by database checks in
/// the additive migration plus the shared request schemas.
model RemoteWalletNotification {
  id             String                             @id @default(cuid())
  remoteWalletId String
  remoteWallet   RemoteWallet                       @relation(fields: [remoteWalletId], references: [id], onDelete: Cascade)
  name           String
  channel        RemoteWalletNotificationChannel
  action         RemoteWalletNotificationAction
  enabled        Boolean                            @default(true)
  pausedAt       DateTime?
  webhookUrl     String?
  nostrKind      Int?
  nostrRecipient String?
  nostrRelays    Json?
  nostrContent   String?
  nip44          Boolean                            @default(false)
  deliveries     RemoteWalletNotificationDelivery[]
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime                           @updatedAt

  @@index([remoteWalletId, createdAt])
  @@index([remoteWalletId, action, enabled])
}

/// Idempotent journal entry for one notification and one wallet event. The
/// unique key makes listener replays and concurrent enqueue calls harmless.
model RemoteWalletNotificationDelivery {
  id             String                                 @id @default(cuid())
  notificationId String
  notification   RemoteWalletNotification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  walletId       String
  wallet         RemoteWallet                           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId         String
  user           User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey       String
  action         RemoteWalletNotificationAction
  payload        Json
  status         RemoteWalletNotificationDeliveryStatus @default(READY)
  attemptCount   Int                                    @default(0)
  lastError      String?
  nextRetryAt    DateTime                               @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  completedAt    DateTime?
  attempts       RemoteWalletNotificationAttempt[]
  createdAt      DateTime                               @default(now())
  updatedAt      DateTime                               @updatedAt

  @@unique([notificationId, eventKey])
  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([status, nextRetryAt])
  @@index([leaseExpiresAt])
}

/// One persisted outbound attempt. It exists before network I/O starts, and
/// requestId is reused as the webhook idempotency key / Nostr event seed.
model RemoteWalletNotificationAttempt {
  id             String                                @id @default(cuid())
  deliveryId     String
  delivery       RemoteWalletNotificationDelivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNo      Int
  requestId      String                                @unique
  status         RemoteWalletNotificationAttemptStatus @default(PENDING)
  responseStatus Int?
  responseBody   String?
  nostrEventId   String?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime                              @default(now())
  resolvedAt     DateTime?

  @@unique([deliveryId, attemptNo])
  @@index([deliveryId, createdAt])
  @@index([status, createdAt])
}

/// User-owned automation attached to a RemoteWallet. V1 exposes FORWARD,
/// while the discriminator keeps the receive-action surface extensible.
model RemoteWalletReceiveAction {
  id                String                              @id @default(cuid())
  remoteWalletId    String                              @unique
  remoteWallet      RemoteWallet                        @relation(fields: [remoteWalletId], references: [id], onDelete: Cascade)
  type              RemoteWalletReceiveActionType       @default(FORWARD)
  enabled           Boolean                             @default(false)
  enabledAt         DateTime?
  pausedAt          DateTime?
  /// Cursor for the missed-payment capture sweep. Null until the first sweep.
  lastSweepAt       DateTime?
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  currentRevisionId String?                             @unique
  currentRevision   RemoteWalletReceiveActionRevision?  @relation("CurrentReceiveActionRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions         RemoteWalletReceiveActionRevision[] @relation("ReceiveActionRevisions")
  receipts          RemoteWalletForwardReceipt[]
  createdAt         DateTime                            @default(now())
  updatedAt         DateTime                            @updatedAt

  @@index([enabled, enabledAt])
  @@index([leaseExpiresAt])
}

/// Immutable forwarding configuration. Receipts and attempts retain their
/// snapshots even after a later revision becomes current.
model RemoteWalletReceiveActionRevision {
  id               String                           @id @default(cuid())
  actionId         String
  action           RemoteWalletReceiveAction        @relation("ReceiveActionRevisions", fields: [actionId], references: [id], onDelete: Cascade)
  currentForAction RemoteWalletReceiveAction?       @relation("CurrentReceiveActionRevision")
  revision         Int
  feeBps           Int                              @default(50)
  baseFeeMsats     BigInt                           @default(1000)
  destinations     RemoteWalletForwardDestination[]
  receipts         RemoteWalletForwardReceipt[]
  createdAt        DateTime                         @default(now())

  @@unique([actionId, revision])
  @@index([actionId, createdAt])
}

model RemoteWalletForwardDestination {
  id            String                            @id @default(cuid())
  revisionId    String
  revision      RemoteWalletReceiveActionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  position      Int
  address       String
  allocationBps Int
  createdAt     DateTime                          @default(now())

  @@unique([revisionId, position])
  @@unique([revisionId, address])
  @@index([revisionId])
}

/// Durable record of one settled incoming payment and its forwarding plan.
model RemoteWalletForwardReceipt {
  id                        String                            @id @default(cuid())
  actionId                  String
  action                    RemoteWalletReceiveAction         @relation(fields: [actionId], references: [id], onDelete: Cascade)
  revisionId                String
  revision                  RemoteWalletReceiveActionRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  walletId                  String
  wallet                    RemoteWallet                      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId                    String
  user                      User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey                  String                            @unique
  sourcePaymentHash         String
  sourceInvoice             String?
  grossAmountMsats          BigInt
  retainedFeeMsats          BigInt
  targetAmountMsats         BigInt
  forwardedAmountMsats      BigInt                            @default(0)
  routingFeeMsats           BigInt                            @default(0)
  routingReserveMsats       BigInt                            @default(0)
  unusedRoutingReserveMsats BigInt                            @default(0)
  routingFeeOverageMsats    BigInt                            @default(0)
  shortfallMsats            BigInt                            @default(0)
  configRevision            Int
  status                    RemoteWalletForwardReceiptStatus  @default(RECEIVED)
  recovered                 Boolean                           @default(false)
  sourceSettledAt           DateTime
  lastError                 String?
  nextRetryAt               DateTime                          @default(now())
  leaseOwner                String?
  leaseExpiresAt            DateTime?
  completedAt               DateTime?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  legs                      RemoteWalletForwardLeg[]

  @@unique([walletId, sourcePaymentHash])
  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([status, nextRetryAt])
  @@index([leaseExpiresAt])
}

model RemoteWalletForwardLeg {
  id                        String                       @id @default(cuid())
  receiptId                 String
  receipt                   RemoteWalletForwardReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  position                  Int
  destination               String
  allocationBps             Int
  requestedAmountMsats      BigInt
  forwardedAmountMsats      BigInt?
  routingFeeMsats           BigInt?
  routingReserveMsats       BigInt                       @default(0)
  unusedRoutingReserveMsats BigInt                       @default(0)
  routingFeeOverageMsats    BigInt                       @default(0)
  destinationShortfallMsats BigInt                       @default(0)
  status                    RemoteWalletForwardLegStatus @default(READY)
  // Carries an unused routing reserve forward as pending balance. Residual legs
  // owe the destination real money but never gate receipt completion.
  residual                  Boolean                      @default(false)
  retryCount                Int                          @default(0)
  nextRetryAt               DateTime                     @default(now())
  lastError                 String?
  supersededAt              DateTime?
  completedAt               DateTime?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  attempts                  RemoteWalletForwardAttempt[]
  batchAnchorId             String?
  batchAnchor               RemoteWalletForwardLeg?      @relation("RemoteWalletForwardLegBatch", fields: [batchAnchorId], references: [id], onDelete: SetNull)
  batchMembers              RemoteWalletForwardLeg[]     @relation("RemoteWalletForwardLegBatch")

  @@unique([receiptId, position])
  @@index([receiptId, status])
  @@index([status, nextRetryAt])
  @@index([batchAnchorId, status])
}

model RemoteWalletForwardAttempt {
  id                  String                           @id @default(cuid())
  legId               String
  leg                 RemoteWalletForwardLeg           @relation(fields: [legId], references: [id], onDelete: Cascade)
  attemptNo           Int
  bolt11              String
  paymentHash         String
  amountMsats         BigInt
  expiresAt           DateTime
  requestId           String                           @unique
  status              RemoteWalletForwardAttemptStatus @default(PENDING)
  preimage            String?
  routingFeeMsats     BigInt?
  routingReserveMsats BigInt                           @default(0)
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  resolvedAt          DateTime?

  @@unique([legId, attemptNo])
  @@index([legId, createdAt])
  @@index([paymentHash])
  @@index([status, updatedAt])
}

/// A physical card. At most one MASTER card may exist per holder — enforced by
/// a raw partial unique index (`Card_userId_master_unique`, on `userId` WHERE
/// `kind = 'MASTER' AND userId IS NOT NULL`), because Prisma can't express
/// partial indexes. Unpaired cards (`userId = null`) are exempt.
///
/// `kind` resets to SIMPLE on every change of holder (claim, OTC activate,
/// unpair) — the designation is about the account, not the plastic, so it
/// never travels to a new owner. Promoting always demotes the holder's
/// previous master first, in a transaction, because Postgres evaluates the
/// partial index mid-transaction.
model Card {
  id                  String    @id @default(uuid())
  designId            String
  ntag424Cid          String?   @unique
  createdAt           DateTime  @default(now())
  title               String?
  lastUsedAt          DateTime?
  // `userId` is the card's current *holder* (owner). A ONE_TIME activation
  // claim transfers this to the new claimer. Pay-time wallet resolution and
  // `users/[userId]/cards` both key off this field.
  userId              String?
  username            String?
  otc                 String?
  remoteWalletId      String?
  kind                CardKind  @default(SIMPLE)
  // One-time, replay-protected programming token for the BoltCard QR. Minted
  // only while the card is still "fresh" (never tapped) and consumed by the
  // first `/write` fetch, so the key-export URL can't be replayed. Null when
  // no token is outstanding; the expiry bounds an un-used token's lifetime.
  writeToken          String?   @unique
  writeTokenExpiresAt DateTime?
  // Set when the card's NTAG424 keys have been exported for *reset* (the
  // `/wipe` flow). A "blocked" card is decommissioned: it can no longer be
  // re-paired, activated, or programmed — only re-wiped (the reset keys stay
  // re-fetchable) until an operator explicitly deletes it. Null = not blocked.
  blockedAt           DateTime?
  // Reversible owner-controlled pause. Disabled cards remain paired and visible
  // in the wallet, but cannot produce payable LNURL-withdraw responses.
  disabledAt          DateTime?

  design           CardDesign            @relation(fields: [designId], references: [id])
  ntag424          Ntag424?              @relation(fields: [ntag424Cid], references: [cid])
  user             User?                 @relation(fields: [userId], references: [id])
  remoteWallet     RemoteWallet?         @relation(fields: [remoteWalletId], references: [id], onDelete: SetNull)
  activationTokens CardActivationToken[]
  paymentAttempts  CardPaymentAttempt[]

  @@index([userId])
  @@index([remoteWalletId])
}

/// An activation token backing a scannable QR for a card. At most one ACTIVE
/// (PENDING) token may exist per (cardId, qrKind) — enforced by a partial
/// unique index added in the migration (Prisma can't express partial indexes).
/// Minting a new token of the same kind first REVOKEs the prior one in a
/// transaction so the constraint holds.
model CardActivationToken {
  id              String                @id @default(cuid())
  cardId          String
  card            Card                  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  qrKind          ActivationQrKind      @default(ONE_TIME)
  status          ActivationTokenStatus @default(PENDING)
  /// The activation URL the wallet scans (e.g. `https://host/activate/<id>`).
  qrPayload       String
  /// DB id of the holder/operator who minted the token (audit only).
  issuedByUserId  String?
  expiresAt       DateTime?
  claimedAt       DateTime?
  /// DB id of the claimer (ONE_TIME only — single audit row).
  claimedByUserId String?
  createdAt       DateTime              @default(now())

  @@index([cardId])
  @@index([status])
}

/// Durable, idempotent record of a BoltCard payment. `walletId` is an audit
/// snapshot rather than a relation: deleting a RemoteWallet configuration must
/// not erase payment history or make the wallet impossible to delete.
///
/// At most one PENDING/UNKNOWN attempt may exist for a card. PostgreSQL enforces
/// that invariant with a partial unique index in the migration because Prisma
/// cannot represent partial indexes in this schema.
model CardPaymentAttempt {
  id            String               @id @default(cuid())
  requestId     String               @unique
  cardId        String
  card          Card                 @relation(fields: [cardId], references: [id], onDelete: Cascade)
  counter       Int
  walletId      String
  paymentHash   String
  bolt11        String
  amountMsats   Int
  transport     CardPaymentTransport
  status        CardPaymentStatus    @default(PENDING)
  preimage      String?
  feesPaidMsats Int?
  errorCode     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  resolvedAt    DateTime?

  @@unique([cardId, counter])
  @@unique([walletId, paymentHash])
  @@index([cardId, createdAt])
  @@index([status, updatedAt])
}

model AlbySubAccount {
  appId       Int      @id
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  username    String? // alby sub account username@getalby.com
  nwcUri      String
  nostrPubkey String? // nostr pubkey for nip57
  createdAt   DateTime @default(now())
}

model Settings {
  name      String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Invoice {
  id                       String         @id @default(uuid())
  bolt11                   String
  paymentHash              String         @unique
  amountSats               Int
  /// Exact amount for msat-denominated proxy invoices. Null on legacy rows.
  amountMsats              BigInt?
  description              String
  purpose                  InvoicePurpose
  metadata                 Json?
  status                   InvoiceStatus  @default(PENDING)
  preimage                 String?
  userId                   String?
  user                     User?          @relation(fields: [userId], references: [id])
  /// The exact wallet that minted this LUD-16 invoice. Keeping this link
  /// makes LUD-21/NIP-57 audit data owner-scoped even when an address is later
  /// rebound to a different RemoteWallet.
  remoteWalletId           String?
  remoteWallet             RemoteWallet?  @relation(fields: [remoteWalletId], references: [id], onDelete: SetNull)
  /// The canonical NIP-57 kind:9734 request committed into this invoice's
  /// description hash. Null for ordinary LUD-16 invoices.
  zapRequest               Json?
  zapRequestJson           String?
  /// The signed kind:9735 receipt retained for the wallet's payment audit.
  zapReceipt               Json?
  zapReceiptJson           String?
  zapReceiptEventId        String?
  zapReceiptPublishedAt    DateTime?
  zapReceiptError          String?
  zapReceiptLeaseOwner     String?
  zapReceiptLeaseExpiresAt DateTime?
  zapReceiptNextRetryAt    DateTime?
  expiresAt                DateTime
  paidAt                   DateTime?
  createdAt                DateTime       @default(now())
  proxyPayment             ProxyPayment?

  @@index([userId])
  @@index([remoteWalletId])
  @@index([status])
  @@index([status, zapReceiptNextRetryAt])
  @@index([purpose, status])
}

/// Singleton operator configuration for the deferred LUD-16 proxy. Secrets
/// are AES-256-GCM envelopes encrypted with NWC_VAULT_SECRET; neither value
/// is exposed by the generic Settings API or included in Settings backups.
model ProxyServiceConfig {
  id                    String    @id @default("default")
  enabled               Boolean   @default(false)
  feeBps                Int       @default(50)
  walletId              String    @unique @default("__lawallet_proxy__")
  nwcCiphertext         Bytes?
  receiptNsecCiphertext Bytes?
  receiptPubkey         String?
  capabilities          Json?
  balanceMsats          BigInt?
  lastProbeAt           DateTime?
  lastProbeError        String?
  lastListenerSeenAt    DateTime?
  lastCronAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Pre-issuance commitment for NIP-57 and fee/destination inputs. The row is
/// written before NWC is asked to mint the payer invoice, then consumed by the
/// transaction that creates Invoice + ProxyPayment. Stale rows are safe to
/// prune because no BOLT11 was ever returned to a payer without that consume.
model ProxyInvoiceIntent {
  id                     String   @id @default(cuid())
  username               String
  userId                 String
  destination            String
  blockedHosts           String[] @default([])
  feeBps                 Int
  grossAmountMsats       BigInt
  serviceFeeMsats        BigInt
  destinationAmountMsats BigInt
  comment                String?
  zapRequest             Json?
  zapRequestJson         String?
  descriptionHash        String?
  expiresAt              DateTime
  createdAt              DateTime @default(now())

  @@index([expiresAt])
}

/// Durable end-to-end state for one payer-facing proxy invoice. The source
/// Invoice settles first; only then may a destination invoice be requested.
model ProxyPayment {
  id                     String                @id @default(cuid())
  invoiceId              String                @unique
  invoice                Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  username               String
  destination            String
  blockedHosts           String[]              @default([])
  destinationMetadata    Json?
  feeBps                 Int
  grossAmountMsats       BigInt
  serviceFeeMsats        BigInt
  destinationAmountMsats BigInt
  forwardedAmountMsats   BigInt?
  routingFeeMsats        BigInt?
  comment                String?
  zapRequest             Json?
  zapRequestJson         String?
  status                 ProxyPaymentStatus    @default(PENDING_INBOUND)
  sourcePaidAt           DateTime?
  sourcePreimage         String?
  forwardedAt            DateTime?
  receiptEventId         String?
  receiptPublishedAt     DateTime?
  retryCount             Int                   @default(0)
  nextRetryAt            DateTime              @default(now())
  lastError              String?
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  attempts               ProxyForwardAttempt[]

  @@index([status, nextRetryAt])
  @@index([leaseExpiresAt])
  @@index([username, createdAt])
}

/// One NWC dispatch attempt. Rejected attempts may be followed by another
/// attempt for the same unexpired BOLT11; a migration trigger prevents that
/// BOLT11/payment hash from belonging to a different ProxyPayment. A new
/// BOLT11 is allowed only after the prior invoice expired unconfirmed.
model ProxyForwardAttempt {
  id              String                    @id @default(cuid())
  proxyPaymentId  String
  proxyPayment    ProxyPayment              @relation(fields: [proxyPaymentId], references: [id], onDelete: Cascade)
  attemptNo       Int
  bolt11          String
  paymentHash     String
  amountMsats     BigInt
  expiresAt       DateTime
  requestId       String                    @unique
  status          ProxyForwardAttemptStatus @default(PENDING)
  preimage        String?
  routingFeeMsats BigInt?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  resolvedAt      DateTime?

  @@unique([proxyPaymentId, attemptNo])
  @@index([proxyPaymentId, createdAt])
  @@index([paymentHash])
  @@index([status, updatedAt])
}

/// Depth marker for a payment this instance forwarded to one of its OWN
/// Lightning Addresses. Forwarding to a local address is allowed, which means
/// the destination can forward again — so every local hop stamps the invoice it
/// is about to pay with `parentDepth + 1`. When that payment later arrives, the
/// receiving side looks itself up here and refuses to forward past
/// `MAX_FORWARD_HOPS`, which is what stops a cycle from running forever.
///
/// Keyed by payment hash rather than carried in the request, so it cannot be
/// spoofed by a caller and works for both the global proxy and RemoteWallet
/// forwarding — a ring that crosses the two subsystems is still caught.
model ForwardingHop {
  id          String   @id @default(cuid())
  paymentHash String   @unique
  depth       Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model ActivityLog {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  category  ActivityCategory
  level     ActivityLevel    @default(INFO)
  event     String
  message   String
  reqId     String?
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  metadata  Json?

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([level, createdAt])
  @@index([userId, createdAt])
  @@index([reqId])
}

model NostrProfileCache {
  npub               String                   @id
  pubkey             String                   @unique
  name               String?
  displayName        String?
  about              String?
  nip05              String?
  lud16              String?
  website            String?
  pictureUrl         String?
  bannerUrl          String?
  kind0CreatedAt     DateTime?
  rawMetadata        Json?
  fetchedAt          DateTime?
  lastFetchAttemptAt DateTime?
  lastFetchError     String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  images             NostrProfileImageCache[]

  @@index([fetchedAt])
}

model NostrProfileImageCache {
  npub        String
  kind        NostrProfileImageKind
  remoteUrl   String
  cachePath   String?
  contentType String?
  byteSize    Int?
  sha256      String?
  cachedAt    DateTime?
  failedAt    DateTime?
  lastError   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  profile     NostrProfileCache     @relation(fields: [npub], references: [npub], onDelete: Cascade)

  @@id([npub, kind])
  @@index([remoteUrl])
  @@index([cachedAt])
}

// Generic JSON-first storage for in-codebase plugins (apps/web/plugins/).
// Plugins persist ALL state here, validated by their own Zod schemas —
// never as new models/columns/enums, which are the merge-conflict seam for
// forks. See docs/PLUGINS.md.
model PluginRecord {
  id        String   @id @default(cuid())
  pluginId  String
  kind      String
  key       String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pluginId, kind, key])
  @@index([pluginId, kind])
}

// A coupon held on a user's behalf, compatible with the lacrypta/coupons
// protocol (https://github.com/lacrypta/coupons). External coupon-manager
// services (CMS) mint coupons and deposit them here against a member's npub;
// the instance stores and displays them, and the merchant's POS burns them.
//
// Custodial by construction: the nonce is a bearer credential sitting in this
// table, and the CMS's own database — not this one — is the authority on
// whether a coupon has been spent. A future protocol version should carry
// vouchers as ecash (Cashu, NIP-60/61) so the bearer value is blinded and the
// operator can't read it. See docs/services/VOUCHERS.md.
model Voucher {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The coupon code: 22-char base64url nonce, and the *only* credential
  /// needed to redeem. Unique per issuing service rather than globally —
  /// two independent CMSs can legitimately mint the same 16 random bytes.
  nonce          String
  /// Coupon *definition* id (uuid) on the issuing service. Many vouchers
  /// share one definition.
  couponId       String?
  name           String
  description    String?
  imageUrl       String?
  /// Where to read more about the offer — the merchant's product or campaign
  /// page. Rendered as a clickable link, so the scheme is constrained to
  /// http(s) on the way in (`externalUrlSchema`): an `<a href>` executes
  /// `javascript:` on click.
  url            String?
  /// Merchant that accepts this voucher (hex pubkey).
  merchantPubkey String
  /// Coupon-manager service that signed the voucher (hex pubkey). Together
  /// with `nonce` this is the row's natural key.
  servicePubkey  String
  /// Service endpoints from the merchant's kind-30078 announcement.
  /// `claimUrl` is what the status refresh polls; `mintUrl` is stored for
  /// completeness so a later phase can re-mint or deep-link without a
  /// second discovery round-trip.
  claimUrl       String
  mintUrl        String?
  /// The protocol `Benefit` plus any extra conditions, verbatim. Opaque on
  /// purpose: the benefit union grows upstream (percent, fixed, multibuy,
  /// buyXgetY, freeItems, …) and a new type must not require a migration.
  metadata       Json?
  /// The CMS-signed kind-20402 event, stored verbatim as provenance so the
  /// voucher stays independently verifiable long after deposit. Null when the
  /// depositor posted plain fields instead of a signed event.
  voucherEvent   Json?

  status          VoucherStatus @default(MINTED)
  expiresAt       DateTime?
  claimedAt       DateTime?
  /// Last time `claimUrl` was polled. Backs the refresh cooldown so the
  /// button can't be used to hammer a third-party service.
  statusCheckedAt DateTime?
  /// NIP-98 pubkey that deposited this row — audit trail, and what an owner
  /// needs in order to build a sender allowlist after the fact. Empty for a
  /// row received by LNURL transfer, which carries no sender identity.
  depositedBy     String
  /// Lightning address this coupon was sent to, once TRANSFERRED. The only
  /// record of where it went — the row is never deleted on send.
  transferredTo   String?
  /// The service's refresh endpoint, when it advertised one. Absent means the
  /// CMS predates refresh and the coupon cannot be transferred.
  refreshUrl      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([servicePubkey, nonce])
  @@index([userId, status])
  @@index([userId, createdAt])
}

/// Write-ahead record of an inbound voucher transfer, on the RECEIVING side.
///
/// Exists because the CMS refresh is the one irreversible step in a transfer:
/// it burns the sender's nonce and mints a replacement. If we called it and
/// then failed to persist the replacement, the coupon would be destroyed —
/// burned at the service, held by nobody. So the intent is written first: a
/// failed insert means we never call refresh (a database outage burns
/// nothing), and a row stuck without `newNonce` is a completed burn we can
/// replay the refresh for, since refresh is idempotent on `Idempotency-Key`.
///
/// The unique key also makes a retried transfer free: the same old nonce from
/// the same service replays the stored answer without touching the CMS.
model VoucherTransfer {
  id             String    @id @default(cuid())
  /// Account that received the transfer.
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Coupon-manager service that signed the incoming voucher (hex pubkey).
  servicePubkey  String
  /// The nonce as it arrived — burned by our refresh, kept as the idempotency key.
  oldNonce       String
  /// The replacement. Null until the refresh has returned and been stored.
  newNonce       String?
  /// Sent to the CMS so a retried refresh replays instead of re-minting.
  idempotencyKey String
  /// The voucher row created once the swap completed.
  voucherId      String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@unique([servicePubkey, oldNonce])
  @@index([userId, createdAt])
}
