{
  "name": "@lawallet-nwc/react",
  "version": "0.1.0",
  "description": "React provider + hooks for LaWallet NWC instances — nostr-first auth, lightning address claiming with payment, remote wallets and live SSE updates",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lawallet-nwc/sdk": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "lawallet",
    "react",
    "hooks",
    "nostr",
    "lightning",
    "nwc"
  ],
  "license": "MIT"
}
