    "test:coverage": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@lawallet-nwc/shared": "workspace:*",
    "openapi3-ts": "^4.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
