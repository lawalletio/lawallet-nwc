{
  "name": "@lawallet-nwc/openapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch scripts/dev-server.mjs",
    "start": "tsx scripts/dev-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
