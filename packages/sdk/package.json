{
  "name": "@lawallet-nwc/sdk",
  "version": "0.1.0",
  "description": "TypeScript client SDK for LaWallet NWC instances — nostr-first (NIP-98 signed requests), lightning address registration, remote wallets, LUD-16 and live events",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "nostr-tools": "^2.25.2"
  },
  "devDependencies": {
    "msw": "^2.15.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "lawallet",
    "nostr",
    "lightning",
    "nwc",
    "nip98",
    "lud16"
  ],
  "license": "MIT"
}
